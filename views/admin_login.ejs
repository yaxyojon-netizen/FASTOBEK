<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Fasto — Admin Kirish</title>
  <link rel="icon" type="image/png" href="/images/fasto_logo.png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0F1117;
      color: #FFFFFF;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .login-box {
      background: #1A1D27;
      border: 1px solid #2A2E3D;
      border-radius: 24px;
      padding: 36px 28px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    .login-logo {
      height: 44px;
      background: #E31B23;
      padding: 6px 14px;
      border-radius: 10px;
      margin-bottom: 16px;
    }

    .login-title {
      font-size: 1.25rem;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .login-desc {
      font-size: 0.85rem;
      color: #8E8E93;
      margin-bottom: 24px;
    }

    /* PIN dots */
    .pin-display {
      display: flex;
      justify-content: center;
      gap: 14px;
      margin-bottom: 24px;
    }

    .pin-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2px solid #3A3F52;
      background: transparent;
      transition: all 0.2s;
    }

    .pin-dot.filled {
      background: #E31B23;
      border-color: #E31B23;
      box-shadow: 0 0 12px rgba(227, 27, 35, 0.6);
      transform: scale(1.15);
    }

    .pin-dot.error {
      background: #FF5252;
      border-color: #FF5252;
    }

    /* Error Message */
    .error-msg {
      color: #FF5252;
      font-size: 0.85rem;
      font-weight: 600;
      min-height: 22px;
      margin-bottom: 16px;
    }

    /* Numpad */
    .numpad {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }

    .num-btn {
      background: #2A2E3D;
      border: 1px solid #3A3F52;
      color: #FFFFFF;
      font-size: 1.4rem;
      font-weight: 700;
      height: 60px;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }

    .num-btn:active {
      transform: scale(0.92);
      background: #E31B23;
      border-color: #E31B23;
    }

    .num-btn.btn-action {
      font-size: 1rem;
      color: #8E8E93;
    }

    .num-btn.btn-action:active {
      background: #3A3F52;
      color: #FFFFFF;
    }

    .btn-login {
      width: 100%;
      background: #E31B23;
      color: #FFFFFF;
      border: none;
      padding: 14px;
      border-radius: 14px;
      font-size: 1rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 16px rgba(227, 27, 35, 0.4);
      transition: all 0.2s;
    }

    .btn-login:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      box-shadow: none;
    }

    .btn-login:not(:disabled):active {
      transform: scale(0.97);
      background: #C61017;
    }

    .back-link {
      display: inline-block;
      margin-top: 18px;
      color: #8E8E93;
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: #FFFFFF;
    }

    /* Shake animation */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-10px); }
      40%, 80% { transform: translateX(10px); }
    }

    .shake {
      animation: shake 0.4s ease;
    }
  </style>
</head>
<body>

  <div class="login-box" id="loginBox">
    <img src="/images/fasto_logo.png" alt="Fasto" class="login-logo">
    <h2 class="login-title">Restoran Boshqaruvi</h2>
    <p class="login-desc">Kirish uchun 4 xonali PIN-kodni kiriting:</p>

    <!-- 4 PIN Dots -->
    <div class="pin-display" id="pinDisplay">
      <div class="pin-dot" id="dot0"></div>
      <div class="pin-dot" id="dot1"></div>
      <div class="pin-dot" id="dot2"></div>
      <div class="pin-dot" id="dot3"></div>
    </div>

    <!-- Error message text -->
    <div class="error-msg" id="errorMsg"></div>

    <!-- Touch Numpad -->
    <div class="numpad">
      <button class="num-btn" onclick="pressNum('1')">1</button>
      <button class="num-btn" onclick="pressNum('2')">2</button>
      <button class="num-btn" onclick="pressNum('3')">3</button>
      <button class="num-btn" onclick="pressNum('4')">4</button>
      <button class="num-btn" onclick="pressNum('5')">5</button>
      <button class="num-btn" onclick="pressNum('6')">6</button>
      <button class="num-btn" onclick="pressNum('7')">7</button>
      <button class="num-btn" onclick="pressNum('8')">8</button>
      <button class="num-btn" onclick="pressNum('9')">9</button>
      <button class="num-btn btn-action" onclick="clearPin()">C</button>
      <button class="num-btn" onclick="pressNum('0')">0</button>
      <button class="num-btn btn-action" onclick="deleteLastNum()"><i class="fas fa-backspace"></i></button>
    </div>

    <button class="btn-login" id="loginBtn" onclick="submitPin()" disabled>
      <i class="fas fa-sign-in-alt"></i> Kirish
    </button>

    <div>
      <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Mijozlar menyusiga qaytish</a>
    </div>
  </div>

  <script>
    let currentPin = '';

    function updateDots() {
      for (let i = 0; i < 4; i++) {
        const dot = document.getElementById('dot' + i);
        if (i < currentPin.length) {
          dot.classList.add('filled');
        } else {
          dot.classList.remove('filled', 'error');
        }
      }
      document.getElementById('loginBtn').disabled = currentPin.length !== 4;
      document.getElementById('errorMsg').textContent = '';
    }

    function pressNum(digit) {
      if (currentPin.length < 4) {
        currentPin += digit;
        updateDots();
        if (currentPin.length === 4) {
          // Auto submit when 4 digits entered
          setTimeout(submitPin, 150);
        }
      }
    }

    function deleteLastNum() {
      if (currentPin.length > 0) {
        currentPin = currentPin.slice(0, -1);
        updateDots();
      }
    }

    function clearPin() {
      currentPin = '';
      updateDots();
    }

    // Physical Keyboard support
    document.addEventListener('keydown', (e) => {
      if (e.key >= '0' && e.key <= '9') {
        pressNum(e.key);
      } else if (e.key === 'Backspace') {
        deleteLastNum();
      } else if (e.key === 'Enter' && currentPin.length === 4) {
        submitPin();
      } else if (e.key === 'Escape') {
        clearPin();
      }
    });

    async function submitPin() {
      if (currentPin.length !== 4) return;

      const loginBox = document.getElementById('loginBox');
      const errorMsg = document.getElementById('errorMsg');
      const loginBtn = document.getElementById('loginBtn');

      loginBtn.disabled = true;
      loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Tekshirilmoqda...';

      try {
        const res = await fetch('/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pin: currentPin })
        });

        const data = await res.json();
        if (data.success) {
          // Redirect to admin panel
          window.location.href = '/admin';
        } else {
          // Error shake
          loginBox.classList.add('shake');
          setTimeout(() => loginBox.classList.remove('shake'), 400);

          for (let i = 0; i < 4; i++) {
            document.getElementById('dot' + i).classList.add('error');
          }
          errorMsg.textContent = data.message || 'Noto\'g\'ri PIN-kod!';
          currentPin = '';
          setTimeout(updateDots, 700);
        }
      } catch (err) {
        errorMsg.textContent = 'Server bilan aloqa uzildi';
      } finally {
        loginBtn.disabled = false;
        loginBtn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Kirish';
      }
    }
  </script>
</body>
</html>
